<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_dashboard_background" android:orientation="vertical" android:padding="5dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/widget_last_feeding" style="@style/WidgetDashboardCompactInfo"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" />
        <TextView android:id="@+id/widget_recommendation" style="@style/WidgetDashboardCompactInfo"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        <TextView android:id="@+id/widget_last_sleep" style="@style/WidgetDashboardCompactInfo"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" />
        <TextView android:id="@+id/widget_vitamin_panel" style="@style/WidgetDashboardCompactInfo"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight=".8" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
        android:layout_marginTop="3dp" android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/widget_milk_action" style="@style/WidgetDashboardAction"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginEnd="2dp" android:background="@drawable/widget_action_milk_background" android:text="Молоко" />
        <TextView android:id="@+id/widget_formula_action" style="@style/WidgetDashboardAction"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginHorizontal="2dp" android:background="@drawable/widget_action_formula_background" android:text="Смесь" />
        <TextView android:id="@+id/widget_sleep_action" style="@style/WidgetDashboardAction"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="2dp" android:background="@drawable/widget_action_sleep_background" />
    </LinearLayout>
</LinearLayout>
