<?xml version="1.0" encoding="utf-8"?>
<!-- One actual launcher row: four full-height action/data tiles. No hidden lower panel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:baselineAligned="false">
    <TextView android:id="@+id/widget_milk_action" style="@style/WidgetDashboardTile"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.35"
        android:layout_marginEnd="2dp" android:background="@drawable/widget_action_milk_background"
        android:text="Молоко 120 мл\n1 ч назад\n＋ Молоко" />
    <TextView android:id="@+id/widget_formula_action" style="@style/WidgetDashboardTile"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1"
        android:layout_marginHorizontal="2dp" android:background="@drawable/widget_action_formula_background"
        android:text="Порция\n130 мл\n＋ Смесь" />
    <TextView android:id="@+id/widget_sleep_action" style="@style/WidgetDashboardTile"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.35"
        android:layout_marginHorizontal="2dp" android:background="@drawable/widget_action_sleep_background"
        android:text="Спит 1 ч\nс 14:30\nПроснулась" />
    <TextView android:id="@+id/widget_vitamin_panel" style="@style/WidgetDashboardTile"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_marginStart="2dp" android:background="@drawable/widget_vitamin_background"
        android:text="D\nНе принят\n＋" />
</LinearLayout>
